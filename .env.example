# ============================================
# Database Configuration
# ============================================
# MySQL Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Default XAMPP:       mysql://root:@localhost:3306/dealer_mobil
# Default Laragon:     mysql://root:@localhost:3306/dealer_mobil
# Default MAMP:        mysql://root:root@localhost:8889/dealer_mobil
# Docker:              mysql://root:password@localhost:3306/dealer_mobil
# Cloud (PlanetScale): mysql://USERNAME:PASSWORD@HOST/DATABASE?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://root:@localhost:3306/dealer_mobil"

# ============================================
# Admin Authentication
# ============================================
# Username & password untuk login di /admin/login
# WAJIB diganti sebelum deploy ke production!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# ============================================
# Session Secret
# ============================================
# Secret key untuk HMAC signing session cookie (min 32 char)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HARUS sinkron dengan fallback di src/middleware.ts dan src/lib/auth.ts
SESSION_SECRET="rahasia-dealer-mobil-2024-ganti-ini-di-production"
